ru:wiki:clownpiece","gelbooru:wiki:clownpiece"]},{"facet":"headwear","canonical_tag":"pink_hat","value":"Pink hat","source_refs":["danbooru:wiki:clownpiece","gelbooru:wiki:clownpiece"]},{"facet":"accessories","canonical_tag":"star_print","value":"Star print","source_refs":["danbooru:wiki:clownpiece","gelbooru:wiki:clownpiece"]},{"facet":"accessories","canonical_tag":"american_flag","value":"American flag theme","source_refs":["danbooru:wiki:clownpiece","gelbooru:wiki:clownpiece"]},{"facet":"accessories","canonical_tag":"neck_ruff","value":"Neck ruff","source_refs":["danbooru:wiki:clownpiece"]},{"facet":"wings","canonical_tag":"fairy_wings","value":"Fairy wings","source_refs":["danbooru:wiki:clownpiece","gelbooru:wiki:clownpiece"]},{"facet":"footwear","canonical_tag":"no_shoes","value":"Usually no shoes","source_refs":["danbooru:wiki:clownpiece"]},{"facet":"props","canonical_tag":"torch","value":"Torch","source_refs":["danbooru:wiki:clownpiece","gelbooru:wiki:clownpiece"]}]}]}